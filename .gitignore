# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
dist/
build/

# uv / virtualenv
.venv/
.python-version

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/

# IDE
.vscode/
.idea/
*.swp

# Claude Code local session state
.claude/

# Local-only artifacts — anchored at repo root so the names don't collide
# with package source directories.
/stash/
/clips/
/data/
/logs/

# Model checkpoints by extension
*.onnx
*.pt
*.pth
*.safetensors

# Regenerable pipeline artifacts / external experiment clones
/output/
/preview_recipe/
/experiments/IC-Light/

# 배포 자격·로컬 오버레이 (env.example만 추적)
/deploy/docker/.env
/deploy/docker/compose.override.yaml

# 고객 픽셀(얼굴 등 개인정보가 담긴 미디어)은 리포에 넣지 않는다.
# 2026-07-28 experiments/*.png 32장 히스토리 소거 — 보존본은 /experiments/media/(로컬 전용),
# 원본 히스토리·해시 대응표는 ~/repo/backups/momentscan-preclean-20260728.git.
# 확장자-무관 일반 가드는 .githooks/pre-commit (활성화: git config core.hooksPath .githooks)
/experiments/media/
/experiments/*.png
