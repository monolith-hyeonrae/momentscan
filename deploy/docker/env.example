# deploy/docker/.env 로 복사해 채운다. 자격·비밀은 이 파일(example)에 절대 커밋 금지.

# ── 웨이트 번들 (S3) ──
MS_MODELS_URI=s3://dev-981park-media-cju/moment-scan/models/momentscan-models-v1.tar

# ── 서버 ──
MS_PORT=8080
MS_PRODUCTS=likeness
MS_APP_NAME=cju-activity-moment-scan-process

# ── 연동 (미설정 = 해당 기능 꺼짐: Eureka 등록 없음 / 디스패치 방언 수신 없음) ──
# MS_EUREKA=http://host.docker.internal:8761/eureka
# MS_CONTROL_URL=https://dev-api.cju.981park.com/activity-video/control
MS_S3_BUCKET=dev-981park-media-cju
MS_OUTPUT_URI=s3://dev-981park-media-cju/moment-scan/out
# MS_ADVERTISE_HOST=            # 생략 = 자동 감지; 컨테이너에서는 호스트 IP를 명시 권장

# ── 회사 Eureka JWT (env로만 — 7/15 실측: 등록·콜백 모두 인증 필수) ──
# EUREKA_TOKEN_URI=
# EUREKA_CLIENT_ID=
# EUREKA_CLIENT_SECRET=

# ── AWS 자격 (인스턴스 프로파일이 있으면 전부 생략; 로컬/온프레미스만) ──
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-northeast-2
